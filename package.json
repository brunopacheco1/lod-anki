{
  "name": "lod-anki",
  "version": "2.2.0",
  "description": "Export words to Anki dictionaries",
  "main": "./lib/index.js",
  "bin": {
    "lod-anki": "./lib/index.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunopacheco1/lod-anki.git"
  },
  "keywords": [
    "LOD.lu",
    "Anki",
    "cli",
    "community",
    "generator"
  ],
  "author": "brunopacheco1",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/brunopacheco1/lod-anki/issues"
  },
  "homepage": "https://github.com/brunopacheco1/lod-anki#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/sax": "^1.2.7",
    "eslint": "^10.12.0",
    "sql.js": "^1.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "anki-apkg-export": "^5.0.0",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "jszip": "^3.10.2",
    "kleur": "^4.1.5",
    "sax": "^1.6.1"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
